# Example ML service environment file.
# Copy this file to .env and fill in the real values.
# NEVER commit the real .env file to the repository.

# OpenAI-compatible LLM endpoint
LLM_BASE_URL=https://openrouter.ai/api/v1

# API key for the LLM endpoint.
# This value is secret. Keep it out of version control.
LLM_API_KEY=your-openrouter-api-key-here

# Model identifier
LLM_MODEL=qwen/qwen-2.5-72b-instruct

# Request timeout in milliseconds (300000 = 5 minutes per HTTP call)
LLM_TIMEOUT_MS=300000

# Number of JSON repair retries
LLM_MAX_RETRIES=2
