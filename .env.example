# Shared environment variables for docker-compose.
# Copy this file to .env (which is git-ignored) and adjust values.

# Backend
BACKEND_PORT=8080
DATABASE_URL=postgres://teamopt:teamopt@postgres:5432/teamopt?sslmode=disable
ML_SERVICE_URL=http://ml:8000

# Postgres
POSTGRES_USER=teamopt
POSTGRES_PASSWORD=teamopt
POSTGRES_DB=teamopt
POSTGRES_PORT=5432

# ML service
ML_PORT=8000

# Frontend
FRONTEND_PORT=3000
