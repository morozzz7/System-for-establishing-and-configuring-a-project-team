# Shared environment variables for docker-compose.
# Copy this file to .env (which is git-ignored) and adjust values.
#
# Standard ports (clean host):
#   Gateway:     80     -> http://localhost/
#   Backend:     8080   -> http://localhost:8080/api/v1/
#   ML:          8000   -> http://localhost:8000/
#   Frontend:    3000   -> http://localhost:3000/
#   Postgres:    5432   -> postgresql://localhost:5432/
#
# Conflict-free ports (use if standard ports occupied):
#   Gateway:     9080   -> http://localhost:9080/
#   Backend:     18080  -> http://localhost:18080/api/v1/
#   ML:          18000  -> http://localhost:18000/
#   Frontend:    13000  -> http://localhost:13000/
#   Postgres:    15432  -> postgresql://localhost:15432/
#
# CONTAINER PORTS NEVER CHANGE: backend=8080, ml=8000, frontend=3000, postgres=5432

# Backend
BACKEND_PORT=8080
DATABASE_URL=postgres://teamopt:teamopt@postgres:5432/teamopt?sslmode=disable
ML_SERVICE_URL=http://ml:8000

# Postgres
POSTGRES_USER=teamopt
POSTGRES_PASSWORD=teamopt
POSTGRES_DB=teamopt
POSTGRES_PORT=5432

# ML service
ML_PORT=8000

# Frontend
FRONTEND_PORT=3000

# Gateway (nginx reverse proxy) - main entry point
GATEWAY_PORT=80
