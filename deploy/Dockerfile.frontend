# Multi-stage: build the React SPA with Vite, then serve with nginx.
#
# The SPA is served behind the gateway (nginx on port 80).
# API calls use relative URLs (/api/v1/...) which the gateway proxies to backend.
# VITE_API_BASE_URL can be empty (relative) or /api/v1 — both work through gateway.
# Override at build time if needed: docker build --build-arg VITE_API_BASE_URL=""

FROM node:20-alpine AS builder

WORKDIR /app

COPY frontend/package.json frontend/package-lock.json* ./
RUN npm install

COPY frontend/ .
ARG VITE_API_BASE_URL=/api/v1
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
RUN npm run build

# --- runtime ---
FROM nginx:1.27-alpine

# Custom nginx config for SPA routing.
COPY deploy/nginx/frontend-nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 3000

HEALTHCHECK --interval=5s --timeout=3s --start-period=10s --retries=6 \
  CMD ["wget", "-qO-", "http://localhost:3000/"]

CMD ["nginx", "-g", "daemon off;"]
