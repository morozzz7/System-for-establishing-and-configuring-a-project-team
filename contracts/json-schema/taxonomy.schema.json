{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.teamopt.internal/v1/taxonomy.schema.json",
  "title": "Competency taxonomy (v1)",
  "description": "Structure of contracts/taxonomy.yaml. Ids and synonyms are stable; renaming an id is a breaking change and needs a new contract version.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "default_locale", "level_scale", "levels", "roles", "competencies"],
  "properties": {
    "schema_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "contract_version": { "type": "string", "enum": ["v1"] },
    "updated": { "type": "string", "format": "date" },
    "default_locale": { "type": "string", "enum": ["ru", "en"] },
    "level_scale": { "const": 5 },
    "levels": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["level", "label_ru", "label_en", "description_ru", "description_en"],
        "properties": {
          "level": { "$ref": "common.schema.json#/$defs/Level" },
          "label_ru": { "type": "string", "maxLength": 40 },
          "label_en": { "type": "string", "maxLength": 40 },
          "description_ru": { "type": "string", "maxLength": 300 },
          "description_en": { "type": "string", "maxLength": 300 }
        }
      }
    },
    "roles": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role_id", "name_en", "name_ru", "family", "synonyms", "core_competencies", "typical_grades"],
        "properties": {
          "role_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,39}$" },
          "name_en": { "type": "string", "maxLength": 120 },
          "name_ru": { "type": "string", "maxLength": 120 },
          "family": {
            "type": "string",
            "enum": ["engineering", "quality", "data", "infrastructure", "product", "analysis", "design", "management", "security"]
          },
          "synonyms": {
            "type": "array",
            "minItems": 1,
            "maxItems": 30,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 2, "maxLength": 80, "pattern": "^[^A-Z]+$" }
          },
          "core_competencies": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "uniqueItems": true,
            "items": { "type": "string" }
          },
          "typical_grades": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "common.schema.json#/$defs/Grade" }
          }
        }
      }
    },
    "competencies": {
      "type": "array",
      "minItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["competency_id", "name_en", "name_ru", "category", "roles", "synonyms"],
        "properties": {
          "competency_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,39}$" },
          "name_en": { "type": "string", "maxLength": 120 },
          "name_ru": { "type": "string", "maxLength": 120 },
          "category": {
            "type": "string",
            "enum": ["language", "framework", "database", "messaging", "cloud", "devops", "testing", "analytics", "ml", "architecture", "security", "process", "domain", "soft_skill"]
          },
          "roles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string" }
          },
          "synonyms": {
            "type": "array",
            "minItems": 1,
            "maxItems": 30,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 2, "maxLength": 80, "pattern": "^[^A-Z]+$" }
          }
        }
      }
    }
  }
}
