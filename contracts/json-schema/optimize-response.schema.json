{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.teamopt.internal/v1/optimize-response.schema.json",
  "title": "Optimize response (v1, ML -> Go)",
  "description": "Output of POST /v1/optimize. Advisory for metrics: Go re-validates every variant against G1-G5 with its own data and recomputes duration, deficits and M1-M12. A response is still expected to be self-consistent, because a validator rejection is tracked as a defect (METRICS 3.2 'solver-validator disagreement').",
  "type": "object",
  "additionalProperties": false,
  "required": ["request_id", "run_id", "solver", "variants", "deterministic_fingerprint", "diagnostics", "reason_codes"],
  "properties": {
    "request_id": { "type": "string", "pattern": "^req_[A-Za-z0-9-]{6,32}$" },
    "run_id": { "type": "string", "pattern": "^run_[A-Za-z0-9]{4,16}$" },
    "solver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "status", "wall_time_ms", "num_workers", "seed", "deterministic"],
      "properties": {
        "name": { "type": "string", "enum": ["ortools-cp-sat"] },
        "version": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["OPTIMAL", "FEASIBLE", "INFEASIBLE", "UNKNOWN", "TIMEOUT", "MODEL_INVALID", "ERROR"]
        },
        "wall_time_ms": { "type": "integer", "minimum": 0 },
        "objective_value": { "type": ["number", "null"] },
        "best_bound": { "type": ["number", "null"] },
        "optimality_gap": { "type": ["number", "null"], "minimum": 0 },
        "num_workers": { "type": "integer", "minimum": 1, "maximum": 16 },
        "seed": { "type": "integer", "minimum": 0 },
        "deterministic": { "type": "boolean" }
      }
    },
    "variants": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["variant_id", "label", "members", "assignments", "metrics", "deficits", "unscheduled_requirements", "active_constraints", "reason_codes"],
        "properties": {
          "variant_id": { "type": "string", "pattern": "^var_[A-Za-z0-9]{2,16}$" },
          "label": { "type": "string", "minLength": 1, "maxLength": 120 },
          "members": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["employee_id", "role_id", "allocated_hours", "assignment_share", "reason_codes"],
              "properties": {
                "employee_id": { "type": "string", "pattern": "^emp_[a-z0-9]{4,12}$" },
                "role_id": { "type": "string" },
                "allocated_hours": { "type": "number", "minimum": 0 },
                "assignment_share": { "type": "number", "minimum": 0, "maximum": 1 },
                "reason_codes": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "$ref": "common.schema.json#/$defs/ReasonCode" }
                }
              }
            }
          },
          "assignments": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["employee_id", "requirement_id", "week", "hours"],
              "properties": {
                "employee_id": { "type": "string", "pattern": "^emp_[a-z0-9]{4,12}$" },
                "requirement_id": { "type": "string" },
                "week": { "$ref": "common.schema.json#/$defs/WeekKey" },
                "hours": { "type": "number", "minimum": 0, "maximum": 60 }
              }
            }
          },
          "metrics": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "M1": { "type": "number", "minimum": 0, "maximum": 1 },
              "M2": { "type": "number", "minimum": 0, "maximum": 1 },
              "M3": { "type": "number", "minimum": 0, "maximum": 1 },
              "M4": { "type": "number", "minimum": 0, "maximum": 1 },
              "M5": { "type": "number", "minimum": 0, "maximum": 1 },
              "M6": { "type": "number", "minimum": 0, "maximum": 1 },
              "M7": { "type": "number", "minimum": 0, "maximum": 1 },
              "M8": { "type": "number", "minimum": 0, "maximum": 1 },
              "M9": { "type": "number", "minimum": 0, "maximum": 1 },
              "M10": { "type": "number", "minimum": 0, "maximum": 1 },
              "M11": { "type": "number", "minimum": 0, "maximum": 1 },
              "M12": { "type": "number", "minimum": 0, "maximum": 1 },
              "score": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          },
          "deficits": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["requirement_ids", "person_days", "external_cooperation_flag", "reason_codes"],
              "properties": {
                "competency_id": { "type": ["string", "null"] },
                "role_id": { "type": ["string", "null"] },
                "requirement_ids": { "type": "array", "items": { "type": "string" } },
                "person_days": { "type": "number", "exclusiveMinimum": 0 },
                "external_cooperation_flag": { "type": "boolean" },
                "reason_codes": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "$ref": "common.schema.json#/$defs/ReasonCode" }
                }
              }
            }
          },
          "unscheduled_requirements": {
            "type": "array",
            "items": { "type": "string" }
          },
          "active_constraints": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "type", "binding", "reason_codes"],
              "properties": {
                "id": { "type": "string" },
                "type": {
                  "type": "string",
                  "enum": ["force_include", "force_exclude", "max_team_size", "min_team_size", "budget_cap", "deadline", "forbid_external", "min_bus_factor", "max_utilization", "capacity"]
                },
                "value": { "type": "string" },
                "binding": { "type": "boolean" },
                "reason_codes": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "$ref": "common.schema.json#/$defs/ReasonCode" }
                }
              }
            }
          },
          "reason_codes": {
            "type": "array",
            "items": { "$ref": "common.schema.json#/$defs/ReasonCode" }
          }
        }
      }
    },
    "deterministic_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "description": "sha256 over the canonical JSON request + solver version. Same input and version must reproduce the same fingerprint and the same variants."
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_version", "weeks", "requirement_count", "candidate_count", "variables", "constraints", "time_limit_ms"],
      "properties": {
        "model_version": { "type": "string" },
        "weeks": { "type": "integer", "minimum": 1 },
        "requirement_count": { "type": "integer", "minimum": 0 },
        "candidate_count": { "type": "integer", "minimum": 0 },
        "variables": { "type": "integer", "minimum": 0 },
        "constraints": { "type": "integer", "minimum": 0 },
        "time_limit_ms": { "type": "integer", "minimum": 0 },
        "presolve_time_ms": { "type": "integer", "minimum": 0 },
        "dropped_diversity_variants": { "type": "integer", "minimum": 0 }
      }
    },
    "reason_codes": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/ReasonCode" }
    },
    "infeasibility": {
      "type": "object",
      "additionalProperties": false,
      "description": "Present when solver.status = INFEASIBLE/TIMEOUT with no variant: why no team exists.",
      "required": ["blocking_constraints"],
      "properties": {
        "blocking_constraints": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "reason_codes"],
            "properties": {
              "type": {
                "type": "string",
                "enum": ["force_include", "force_exclude", "max_team_size", "min_team_size", "budget_cap", "deadline", "forbid_external", "min_bus_factor", "max_utilization", "capacity"]
              },
              "value": { "type": "string" },
              "reason_codes": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "common.schema.json#/$defs/ReasonCode" }
              }
            }
          }
        },
        "deficits": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["requirement_ids", "person_days", "reason_codes"],
            "properties": {
              "competency_id": { "type": ["string", "null"] },
              "role_id": { "type": ["string", "null"] },
              "requirement_ids": { "type": "array", "items": { "type": "string" } },
              "person_days": { "type": "number", "minimum": 0 },
              "reason_codes": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "common.schema.json#/$defs/ReasonCode" }
              }
            }
          }
        },
        "unscheduled_requirements": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "allOf": [
    {
      "description": "INFEASIBLE must be explained: no variants, but a populated infeasibility report (blocking constraints and/or deficits).",
      "if": {
        "properties": { "solver": { "properties": { "status": { "const": "INFEASIBLE" } }, "required": ["status"] } },
        "required": ["solver"]
      },
      "then": {
        "properties": {
          "variants": { "maxItems": 0 },
          "infeasibility": { "type": "object", "required": ["blocking_constraints"] }
        },
        "required": ["infeasibility"]
      }
    }
  ]
}
